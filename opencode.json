{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gis": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "mcps.server"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "gis_*": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "gis-orchestrator": {
      "mode": "primary",
      "description": "GIS 主调度智能体 - 管理地名查询、距离量算、路径规划三个子智能体",
      "permission": {
        "task": {
          "geocoder": "allow",
          "distance-measure": "allow",
          "route-planner": "allow"
        }
      },
      "skills": {
        "geocode-candidates-check": true
      },
      "tools": {
        "gis_*": false,
        "webfetch": false,
        "bash": false,
        "write": false,
        "edit": false
      }
    }
  }
}